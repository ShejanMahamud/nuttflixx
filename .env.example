# -----------------------------------------------------------------------------
# NuttFlixx Environment Variables
# Copy this file to .env.local and update the values:
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# TMDB (The Movie Database) API Key [REQUIRED]
# Register and get your free API key at: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Site URL [OPTIONAL]
# Used for canonical metadata, sitemap, and Open Graph image generation.
# On Vercel, this is auto-detected. For local dev, defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
