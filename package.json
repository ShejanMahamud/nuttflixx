{
  "name": "nuttflixx",
  "version": "1.0.0",
  "description": "A modern, open-source movie and TV show discovery & streaming web app built with Next.js 16, React 19, Tailwind CSS v4, and TMDB API.",
  "type": "module",
  "license": "MIT",
  "author": "Shejan Mahamud",
  "keywords": [
    "nextjs",
    "react19",
    "typescript",
    "tailwindcss",
    "tmdb",
    "movie-app",
    "streaming",
    "shadcn-ui",
    "open-source"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const og=path.dirname(require.resolve('next/package.json'))+'/dist/compiled/@vercel/og';const bin=og+'/noto-sans-v27-latin-regular.ttf.bin';const ttf=og+'/noto-sans-v27-latin-regular.ttf';if(fs.existsSync(bin)&&!fs.existsSync(ttf)){fs.copyFileSync(bin,ttf);console.log('Fixed @vercel/og font asset');}}catch(e){}\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "shadcn": "^4.6.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
